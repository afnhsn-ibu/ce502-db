# Copy to .env and edit. Never commit your real .env (it may contain API keys): .gitignore excludes it.
DATA_DIR=data
CHROMA_DIR=chroma_store
COLLECTION=docs
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
# Best chunk farther than this cosine distance -> "I do not know". Calibrate it on your labelled questions.
NO_ANSWER_DISTANCE=0.9
# EMBED_MODE=hash                 # force the offline fallback (fast, no download, word overlap only)
# EMBED_MODEL=all-MiniLM-L6-v2    # any sentence-transformers model; this template assumes 384 dimensions

# Optional LLM [test before class]: set ONE key and the model name your provider offers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=
